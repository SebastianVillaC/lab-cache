{
  "name": "lab-cache",
  "version": "0.1.0",
  "private": true,
  "description": "Laboratorio: pruebas de integración y de sistema de una API con caché (Redis) y base de datos (PostgreSQL)",
  "type": "module",
  "main": "api/src/server.ts",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env api/src/server.ts",
    "start": "node --env-file-if-exists=.env api/src/server.ts",
    "typecheck": "tsc",
    "test": "jest --passWithNoTests",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait",
    "infra:logs": "docker compose logs -f",
    "db:psql": "docker compose exec postgres psql -U lab -d labcache",
    "redis:cli": "docker compose exec redis redis-cli",
    "redis:inspeccionar": "scripts/redis-inspeccionar.sh",
    "falla:redis-caida": "scripts/redis-caida.sh",
    "falla:redis-recuperar": "scripts/redis-recuperar.sh",
    "falla:bd-directa": "scripts/bd-escritura-directa.sh",
    "hallazgo:cliente-redis": "scripts/medir-cliente-redis.sh"
  },
  "dependencies": {
    "express": "5.2.1",
    "pg": "8.23.1",
    "redis": "6.3.0"
  },
  "devDependencies": {
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "typescript": "7.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "transform": {
      "^.+\\.ts$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript"
            },
            "target": "es2024"
          },
          "module": {
            "type": "commonjs"
          }
        }
      ]
    }
  }
}
