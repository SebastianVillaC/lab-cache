# API
PORT=3000

# PostgreSQL (lo usan compose.yaml y la API)
# Puertos del host no estándar para no chocar con otros Postgres/Redis locales.
# Si cambias PG_PORT o REDIS_PORT, ajusta también DATABASE_URL y REDIS_URL.
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab
POSTGRES_DB=labcache
PG_PORT=5433
DATABASE_URL=postgres://lab:lab@localhost:5433/labcache

# Redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
CACHE_TTL_SECONDS=60
REDIS_COMMAND_TIMEOUT_MS=500
